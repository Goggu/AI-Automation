# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — copy this file to .env and fill in every value
#  Never commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────


# ── Meta / Instagram ──────────────────────────────────────────────────────────

# Any string you choose — must match exactly what you enter in the
# Meta Developer Console under Webhooks → Verify Token
VERIFY_TOKEN=1234

# Long-lived Page Access Token from Meta Developer Console
# App Dashboard → your app → Instagram → Generate Token
PAGE_ACCESS_TOKEN={ACCESS_TOKEN}  // change this

# The IG-scoped ID of your own Instagram account / page.
# Used to filter out echo messages the bot sends to itself.
# Find it: GET https://graph.facebook.com/me?access_token=<PAGE_ACCESS_TOKEN>

INSTAGRAM_ACCOUNT_ID={IG_ACCOUNT_TOKEN}  // change this

# Graph API version (default: v25.0 — change only if Meta deprecates it)
# GRAPH_API_VERSION=v25.0


# ── Anthropic (Claude) ────────────────────────────────────────────────────────

#ANTHROPIC_API_KEY={}  // Change this (optional)

# Model to use for the agent + image analysis (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL={}


# ── Google Gemini — audio transcription only ──────────────────────────────────
# Leave blank if you do not need voice-message support

GOOGLE_API_KEY={} // change this

# Gemini model used for audio transcription (default: models/gemini-1.5-flash)
# GEMINI_AUDIO_MODEL=models/gemini-1.5-flash


# ── Google Sheets (inventory / stock database) ────────────────────────────────

# The long ID in your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit

GOOGLE_SHEET_ID={}  // change this
# Name of the sheet tab that holds the inventory (default: Sheet1)
# SHEET_NAME=Sheet1

# Option A — path to the downloaded service-account JSON key file (local / VPS)

GOOGLE_CREDENTIALS_FILE=service_account.json

# Option B — paste the entire service-account JSON as a single-line string
# (useful for cloud platforms like Railway / Render where you can't upload files)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}


# ── WhatsApp checkout redirect ────────────────────────────────────────────────

# Your WhatsApp business number in international format (no spaces)

WHATSAPP_NUMBER={}  // change this

# Prefix for the pre-filled order text sent to WhatsApp
# Result: ORDER-IG-SHIRT001_Main
# WHATSAPP_ORDER_PREFIX=ORDER-IG


# ── Conversation memory ───────────────────────────────────────────────────────

# Number of back-and-forth turns kept in memory per user (default: 10)
# MEMORY_WINDOW_TURNS=10


# ── App ───────────────────────────────────────────────────────────────────────

PORT=5000
DEBUG=false
